# CampusServ Environment Variables Template
# Copy this file to .env or .env.local and configure your environment-specific values.

# Sendinblue / Brevo Email API Key
SENDINBLUE_API_KEY=your_sendinblue_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=sender@campusserv.com
BREVO_SENDER_NAME="CampusServ"

# Security Secrets
JWT_SECRET=your_jwt_secret_here
INTERNAL_SERVICE_SECRET=your_internal_service_secret_here

# Third-Party Integrations
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here
GOOGLE_API_KEY=your_google_api_key_here
